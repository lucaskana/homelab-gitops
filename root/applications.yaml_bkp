apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: applications
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/lucaskana/homelab-gitops.git
    targetRevision: develop
    path: applications
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true     # Deleta recursos no cluster se você apagá-los no Git
      selfHeal: true  # Corrige o cluster automaticamente se alguém alterar algo manualmente